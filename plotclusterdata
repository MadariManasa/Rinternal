plot(irisPetal. Length, irisPetal.Width,
col=model$cluster,
main="K-Means Clustering",
xlab="Petal Length",
ylab="Petal Width")

# Load dataset
data(iris)

# Select numeric columns
x <- iris[, 1:4]

# Apply K-means clustering
set.seed(123)
model <- kmeans(x, centers = 3)

# Plot clusters
plot(x$Sepal.Length, x$Petal.Length,
     col = model$cluster,
     pch = 19,
     main = "K-means Clustering",
     xlab = "Sepal Length",
     ylab = "Petal Length")

# Display cluster centers
points(model$centers[, "Sepal.Length"],
       model$centers[, "Petal.Length"],
       col = 1:3, pch = 8, cex = 2)

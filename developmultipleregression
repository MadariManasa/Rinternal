# Create sample dataset
data <- data.frame(
  hours = c(2, 3, 4, 5, 6),
  attendance = c(60, 70, 75, 80, 90),
  marks = c(40, 50, 60, 70, 85)
)

# Build multiple regression model
model <- lm(marks ~ hours + attendance, data = data)

# Display model results
summary(model)
